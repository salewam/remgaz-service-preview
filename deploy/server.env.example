# Copy privately to /etc/remgaz/server.env (root:remgaz, mode 0640), outside dist.
# The API exists independently. These settings DO NOT connect existing mailto forms to it.
# Build only in an inactive release, never in /opt/remgaz/current; local dist rebuild removes old tags.
# Before switching current atomically, run assets:install for the new release into shared assets.
# The operator restarts the API only when moving to the new release.
# PUBLIC_ORIGIN is the exact browser origin, e.g. your real https origin (no trailing slash).
PUBLIC_ORIGIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generate independently as a random secret of at least 32 bytes; never commit it.
LEAD_IP_HASH_SECRET=
LEAD_DB_PATH=/var/lib/remgaz/leads.sqlite
HOST=127.0.0.1
PORT=8080
# true only behind nginx on this same host; nginx overwrites X-Real-IP.
TRUST_PROXY=true
# Optional; if enabled, browser integration must supply a valid turnstileToken.
TURNSTILE_SECRET=

# Private Telegram user IDs allowed to edit the site; never use a group/chat ID here.
TELEGRAM_ADMIN_IDS=
# After the HTTPS app is reachable, run from the release directory:
# node --env-file=/etc/remgaz/server.env scripts/configure-admin-bot.mjs
# Adds "Управление сайтом" only for these users; leaves webhook and polling unchanged.
# Site content and uploads survive code releases and stay outside dist.
CONTENT_DB_PATH=/var/lib/remgaz/content.sqlite
CONTENT_MEDIA_DIR=/var/lib/remgaz/media
