# Copy privately to /etc/remgaz/server.env (root:remgaz, mode 0640), outside dist.
# Forms send to /api/lead using the same API host as the public site content.
# Build only in an inactive release, never in /opt/remgaz/current; local dist rebuild removes old tags.
# Before switching current atomically, run assets:install for the new release into shared assets.
# The operator restarts the API only when moving to the new release.
# PUBLIC_ORIGIN is the exact API/site origin (no trailing slash).
PUBLIC_ORIGIN=
# Additional exact browser origins permitted to submit leads, comma-separated; never use *.
# For this GitHub Pages site: https://salewam.github.io
LEAD_ALLOWED_ORIGINS=
TELEGRAM_BOT_TOKEN=
# Optional lead-notification recipient only, never an authorization setting.
# Leave blank to save leads and bind the first operator from verified Telegram Mini App login.
# Explicit TELEGRAM_CHAT_ID takes priority; later operators never replace the saved recipient.
# Leads remain visible in the Mini App even if Telegram rejects an alert or delivery is uncertain.
TELEGRAM_CHAT_ID=
# Generate independently as a random secret of at least 32 bytes; never commit it.
LEAD_IP_HASH_SECRET=
LEAD_DB_PATH=/var/lib/remgaz/leads.sqlite
HOST=127.0.0.1
PORT=8080
# true only behind nginx on this same host; nginx overwrites X-Real-IP.
TRUST_PROXY=true
# Optional; if enabled, browser integration must supply a valid turnstileToken.
TURNSTILE_SECRET=

# Every user of this bot with genuine, unexpired Telegram Mini App authorization can edit the site.
# Ordinary browsers and forged Telegram data cannot authorize editing.
# After the HTTPS app is reachable, run from the release directory:
# node --env-file=/etc/remgaz/server.env scripts/configure-admin-bot.mjs
# Sets the default "Управление сайтом" button for all private bot chats; leaves webhook and polling unchanged.
# Site content and uploads survive code releases and stay outside dist.
CONTENT_DB_PATH=/var/lib/remgaz/content.sqlite
CONTENT_MEDIA_DIR=/var/lib/remgaz/media
